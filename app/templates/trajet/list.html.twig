{% extends 'base.html.twig' %}

{% block title %}Liste des trajets{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Liste des trajets</h1>
        <p>Combinez plusieurs critères pour retrouver un trajet.</p>
    </div>

    <form id="searchForm" class="filter-bar" autocomplete="off">
        <div class="filter-row filter-row-route">
            <div class="filter-field">
                <label for="fDepart">Départ</label>
                <div class="field-wrap {% if app.request.get('depart') %}has-value{% endif %}">
                    <input type="text" id="fDepart" name="depart" placeholder="Ville de départ" value="{{ app.request.get('depart') }}">
                    <button type="button" class="clear-btn" data-clears="fDepart" aria-label="Effacer le départ">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>

            <div class="filter-field">
                <label for="fArrivee">Arrivée</label>
                <div class="field-wrap {% if app.request.get('arrivee') %}has-value{% endif %}">
                    <input type="text" id="fArrivee" name="arrivee" placeholder="Ville d'arrivée" value="{{ app.request.get('arrivee') }}">
                    <button type="button" class="clear-btn" data-clears="fArrivee" aria-label="Effacer l'arrivée">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="filter-row filter-row-extra">
            <div class="filter-field">
                <label for="fTemps">Temps</label>
                <div class="field-wrap {% if app.request.get('temps') %}has-value{% endif %}">
                    <input type="text" id="fTemps" name="temps" placeholder="Ex : 5h45" value="{{ app.request.get('temps') }}">
                    <button type="button" class="clear-btn" data-clears="fTemps" aria-label="Effacer le temps">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>

            <div class="filter-field">
                <label for="fObservations">Observation</label>
                <div class="field-wrap {% if app.request.get('observations') %}has-value{% endif %}">
                    <input type="text" id="fObservations" name="observations" placeholder="Ex : A1/A6" value="{{ app.request.get('observations') }}">
                    <button type="button" class="clear-btn" data-clears="fObservations" aria-label="Effacer l'observation">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="filter-meta" id="resultCount"></div>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th scope="col">Départ</th>
                    <th scope="col">Arrivée</th>
                    <th scope="col">Temps</th>
                    <th scope="col">Observation</th>
                    <th scope="col" class="col-actions" style="justify-content:flex-end">Actions</th>
                </tr>
            </thead>
            <tbody id="trajetList">
                {% include 'trajet/_trajet_list.html.twig' with { 'trajets': trajets } %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('trajet_new') }}" class="fab" aria-label="Créer un nouveau trajet" title="Créer un nouveau trajet">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    </a>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    var form = document.getElementById('searchForm');
    var fields = ['fDepart', 'fArrivee', 'fTemps', 'fObservations'];
    var paramByFieldId = { fDepart: 'depart', fArrivee: 'arrivee', fTemps: 'temps', fObservations: 'observations' };
    var list = document.getElementById('trajetList');
    var resultCount = document.getElementById('resultCount');
    var listUrl = '{{ path('trajet_list') }}';
    var debounceTimer = null;
    var currentRequest = null;

    function inputEl(id) { return document.getElementById(id); }

    function toggleClearButton(input) {
        var wrap = input.closest('.field-wrap');
        wrap.classList.toggle('has-value', input.value.length > 0);
    }

    function updateResultCount() {
        var rows = list.querySelectorAll('tr.data-row').length;
        if (!rows) {
            resultCount.textContent = '';
            return;
        }
        resultCount.textContent = rows + ' trajet' + (rows > 1 ? 's' : '') + ' trouvé' + (rows > 1 ? 's' : '');
    }

    function performSearch() {
        var params = new URLSearchParams();
        fields.forEach(function (id) {
            params.set(paramByFieldId[id], inputEl(id).value);
        });

        if (currentRequest) {
            currentRequest.abort();
        }
        var controller = new AbortController();
        currentRequest = controller;

        fetch(listUrl + '?' + params.toString(), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            signal: controller.signal
        })
            .then(function (response) { return response.text(); })
            .then(function (html) {
                list.innerHTML = html;
                updateResultCount();
            })
            .catch(function (error) {
                if (error.name !== 'AbortError') {
                    console.error(error);
                }
            });
    }

    fields.forEach(function (id) {
        var input = inputEl(id);
        input.addEventListener('input', function () {
            toggleClearButton(input);
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(performSearch, 250);
        });
        toggleClearButton(input);
    });

    document.querySelectorAll('.clear-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = inputEl(btn.dataset.clears);
            input.value = '';
            toggleClearButton(input);
            input.focus();
            performSearch();
        });
    });

    form.addEventListener('submit', function (e) { e.preventDefault(); });

    updateResultCount();
})();
</script>
{% endblock %}
