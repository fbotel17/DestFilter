{# templates/trajet/_trajet_list.html.twig #}
{% for trajet in trajets %}
    <tr class="data-row">
        <td data-label="Départ">{{ trajet.depart }}</td>
        <td data-label="Arrivée">{{ trajet.arrivee }}</td>
        <td data-label="Temps">{{ trajet.temps }}</td>
        <td data-label="Observation">{{ trajet.observations|default('—') }}</td>
        <td class="col-actions">
            <a href="{{ path('trajet_edit', {'id': trajet.id}) }}" class="btn btn-secondary btn-sm btn-icon" aria-label="Modifier">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            </a>
            <form method="post" action="{{ path('trajet_delete', {'id': trajet.id}) }}" style="display:inline-block;" onsubmit="return confirm('Voulez-vous vraiment supprimer ce trajet ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trajet.id) }}">
                <button class="btn btn-danger btn-sm btn-icon" aria-label="Supprimer">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
            </form>
        </td>
    </tr>
{% else %}
    <tr class="empty-row">
        <td colspan="5">
            <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            Aucun trajet trouvé.
        </td>
    </tr>
{% endfor %}
