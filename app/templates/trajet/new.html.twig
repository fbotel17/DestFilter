{# templates/trajet/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouveau trajet{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Créer un nouveau trajet</h1>
        <p>Renseignez les informations du trajet à ajouter.</p>
    </div>

    <div class="card card-narrow">
        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.depart) }}
                {{ form_widget(form.depart, {'attr': {'autocomplete': 'off'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.arrivee) }}
                {{ form_widget(form.arrivee, {'attr': {'autocomplete': 'off'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.temps) }}
                {{ form_widget(form.temps, {'attr': {'autocomplete': 'off'}}) }}
            </div>

            <div class="form-group">
                {{ form_label(form.observations) }}
                {{ form_widget(form.observations, {'attr': {'autocomplete': 'off'}}) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-block">Enregistrer</button>
            </div>
        {{ form_end(form) }}

        <a href="{{ path('trajet_list') }}" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Retour à la liste des trajets
        </a>
    </div>
{% endblock %}
